{
  "name": "avnav-viewer",
  "version": "1.0.0",
  "description": "viewer part of avnav",
  "main": "avnav_viewer.js",
  "scripts": {
    "watch": "vite build --config vite.config.mjs --mode development-unminified --watch",
    "debug": "npm run vite:build:nomin",
    "production": "npm run vite:build",
    "vite:dev": "vite --config vite.config.mjs --open /viewer/avnav_viewer.html",
    "vite:def": "vite --config vite.config.mjs --open /viewer/avnav_viewer.html",
    "vite:build": "vite build --config vite.config.mjs --mode production",
    "vite:build:nomin": "vite build --config vite.config.mjs --mode development-unminified",
    "vite:build:nomain": "npm run vite:build:nomin",
    "vite:preview": "vite preview --config vite.config.mjs",
    "compat:targets": "browserslist",
    "compat:lint": "eslint --config eslint.compat.config.mjs components gui map nav util hoc api App.jsx avnav_viewer.js --max-warnings=0",
    "compat:syntax:debug": "es-check --module es2018 'build/debug/**/*.js'",
    "compat:syntax:release": "es-check --module es2018 'build/release/**/*.js'",
    "compat:check:debug": "npm run debug && npm run compat:syntax:debug"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wellenvogel/avnav/tree/master/viewer"
  },
  "browserslist": [
    "> 0.25%",
    "not dead",
    "safari >= 12"
  ],
  "author": "Andreas Vogel",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@maplibre/geojson-vt": "^6.3.0",
    "@types/geodesy": "^2.2.8",
    "@types/js-yaml": "^4.0.9",
    "@types/prop-types": "^15.7.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-react": "^6.3.0",
    "es-check": "^9.9.0",
    "eslint": "^8.57.0",
    "eslint-plugin-compat": "^6.2.1",
    "eslint-plugin-react": "^7.34.3",
    "globals": "^15.6.0",
    "less": "^4.2.0",
    "nlf": "^2.1.1",
    "prop-types": "^15.8.1",
    "qrcode.react": "^3.1.0",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.13.1",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "@braintree/browser-detection": "^2.0.0",
    "@openlayers/pepjs": "^0.5.4",
    "@zip.js/zip.js": "^2.8.8",
    "canvas-gauges": "git+https://github.com/wellenvogel/canvas-gauges#av20220223",
    "clone-deep": "^4.0.1",
    "codeflask": "git+https://github.com/wellenvogel/CodeFlask.git#20220109",
    "core-js": "3.46.0",
    "create-react-class": "^15.7.0",
    "drag-drop-touch": "^1.3.1",
    "fullscreen-polyfill": "^1.0.4",
    "geodesy": "^2.4.0",
    "htm": "^3.1.1",
    "js-yaml": "^4.1.1",
    "maplibre-gl": "^6.19.0",
    "object-assign": "^4.1.1",
    "ol": "10.7.0",
    "pmtiles": "^4.3.2",
    "prismjs": "^1.29.0",
    "PubSub": "^4.0.0",
    "react": "^18.3.1",
    "react-html-parser": "git+https://github.com/wellenvogel/react-html-parser.git#av-20240619",
    "shallow-equal": "^3.1.0",
    "tinycolor2": "^1.6.0",
    "xml-utils": "^1.10.1",
    "xml-writer": "^1.7.0"
  }
}
